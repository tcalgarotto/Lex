# =====================================================================
# Lex — variáveis para PRODUÇÃO (Vercel + Supabase Cloud + Upstash + Qdrant Cloud + Inngest Cloud).
#
# NÃO copie este arquivo para a Vercel diretamente — ele é referência.
# Use a console Vercel → Project Settings → Environment Variables, ou `vercel env`.
#
# Variáveis marcadas como [REQUIRED] precisam estar configuradas para o app
# subir saudável. As [REQUIRED-SECRET] devem ficar APENAS na Vercel/secret manager
# — nunca em arquivos commitados.
#
# ⚠️ TRÊS REGRAS NA VERCEL (evitam 90% dos incidentes):
#   1. ESCOPO: marque "Production" (não só Preview). Variável em Preview NÃO
#      vaza pro deploy de produção.
#   2. REDEPLOY: editar env var não atualiza o deploy ativo — Deployments →
#      Redeploy depois de salvar.
#   3. FORMATO:
#      - DATABASE_URL = pooler TRANSACTION (porta 6543, pgbouncer=true&connection_limit=1)
#      - DIRECT_URL   = pooler SESSION    (porta 5432, sem pgbouncer)
#      - REDIS_URL    = rediss:// (TLS), NÃO https:// (REST API não funciona com ioredis)
# =====================================================================

# =================== A) App ===================
NODE_ENV=production
# [REQUIRED] URL canônica de produção
NEXT_PUBLIC_APP_URL=https://lex-navy.vercel.app
LOG_LEVEL=info
PRISMA_QUERY_LOGS=false

# =================== B) Supabase ===================
# [REQUIRED] Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# [REQUIRED-SECRET]
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# [REQUIRED] Postgres pooler:
#   - DATABASE_URL: TRANSACTION mode (porta 6543) — uso geral
#   - DIRECT_URL:   SESSION mode    (porta 5432) — só para `prisma migrate deploy`
DATABASE_URL=postgresql://postgres.<project-ref>:<PWD>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:<PWD>@aws-1-<region>.pooler.supabase.com:5432/postgres

# [REQUIRED] Storage bucket
STORAGE_BUCKET_DOCUMENTS=documents

# =================== C) Redis (Upstash ou Redis Cloud) ===================
# [REQUIRED-SECRET] Em produção sempre exigido.
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
REDIS_REQUIRED=true
REDIS_NAMESPACE=lex:prod

# =================== D) Qdrant Cloud ===================
# [REQUIRED-SECRET]
QDRANT_URL=https://<cluster>.<region>.aws.cloud.qdrant.io
QDRANT_API_KEY=<api-key>
QDRANT_COLLECTION=lex_main
QDRANT_COLLECTION_CORPUS_NORMS=lex_corpus_norms
QDRANT_COLLECTION_CORPUS_JURISPRUDENCE=lex_corpus_jurisprudence
QDRANT_REQUIRED=true

# =================== E) Inngest Cloud ===================
# [REQUIRED-SECRET]
INNGEST_EVENT_KEY=<event-key-from-console>
INNGEST_SIGNING_KEY=signkey-<from-console>
INNGEST_APP_ID=lex-production

# =================== F) IA ===================
AI_CHAT_PROVIDER=deepseek
# [REQUIRED-SECRET] (pelo menos um do provider escolhido)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# [REQUIRED-SECRET] embeddings BGE-M3 + reranker
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# =================== G) OAuth (configurados via Supabase Console) ===================
# Estas variáveis ficam no painel Supabase → Authentication → Providers.
# Listadas aqui só para auditoria.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# =================== H) Email ===================
# [REQUIRED-SECRET]
RESEND_API_KEY=re_xxx
EMAIL_FROM="Lex <no-reply@<seu-dominio-verificado-no-resend>>"

# =================== I) Observabilidade ===================
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# =================== J) Provedores jurídicos públicos (corpus RAG) ===================
# Política em produção (TUDO LIVE — full coverage):
#   - LexML/STF/STJ em `live` (APIs públicas sem chave; rate-limit cooperativo).
#   - DataJud em `live` — exige DATAJUD_API_KEY (pegue em
#     https://datajud-wiki.cnj.jus.br/api-publica/acesso). Sem a chave o
#     provider fica `not_configured` e jobs caem com NonRetriableError, mas
#     o build/health NÃO quebram.
#   - Câmara dos Deputados e Senado Federal em `live` — APIs públicas sem auth.
#   - 91 tribunais DataJud disponíveis em src/lib/datajud/datajud-aliases.ts:
#       4 superiores (STJ, TST, TSE, STM)
#     +27 TJs estaduais
#     + 6 TRFs
#     +24 TRTs
#     +27 TREs
#     + 3 TJMs
#     = 91 aliases oficiais. DATAJUD_DEFAULT_ALIAS é apenas fallback técnico
#       quando o CNJ/processo não identifica o tribunal.
# Ver docs/LEGAL_PROVIDERS.md e docs/DATAJUD_SETUP.md.

LEXML_BASE_URL=https://www.lexml.gov.br/busca/SRU
LEXML_PROVIDER_MODE=live
LEXML_DEFAULT_PAGE_SIZE=50
LEXML_MAX_PAGES_PER_SYNC=20
LEXML_RATE_LIMIT_PER_MINUTE=20

STF_BASE_URL=https://portal.stf.jus.br
STF_PROVIDER_MODE=live
STF_RATE_LIMIT_PER_MINUTE=10

STJ_BASE_URL=https://processo.stj.jus.br
STJ_PROVIDER_MODE=live
STJ_RATE_LIMIT_PER_MINUTE=10

# DataJud — REQUIRED em produção: DATAJUD_API_KEY
# Sem chave → status: not_configured (não quebra build/health, mas jobs falham).
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_API_KEY=
DATAJUD_DEFAULT_ALIAS=api_publica_tjrs
DATAJUD_MODE=live
DATAJUD_PROVIDER_MODE=live
DATAJUD_DEFAULT_PAGE_SIZE=100
DATAJUD_MAX_PAGES_PER_SYNC=10
DATAJUD_RATE_LIMIT_PER_MINUTE=30
DATAJUD_SYNC_DAILY_ENABLED=true
DATAJUD_SYNC_DAILY_HOUR=6

CAMARA_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
CAMARA_PROVIDER_MODE=live
CAMARA_RATE_LIMIT_PER_MINUTE=30
SENADO_BASE_URL=https://legis.senado.leg.br/dadosabertos
SENADO_PROVIDER_MODE=live
SENADO_RATE_LIMIT_PER_MINUTE=30

# =================== K) Feature flags ===================
ENABLE_CORPUS_SYNC=true
ENABLE_LEGAL_RETRIEVAL=true
ENABLE_CORPUS_GRAPH=true
ENABLE_COCKPIT=true
ENABLE_STRATEGY=true
ENABLE_LAWYER_BRAIN=true
ENABLE_INTEGRATIONS_MOCKS=false
ENABLE_E2E_TEST_HELPERS=false

# Todos os providers ativos por padrão em produção.
ENABLE_LEXML_PROVIDER=true
ENABLE_STF_PROVIDER=true
ENABLE_STJ_PROVIDER=true
ENABLE_DATAJUD=true
ENABLE_CAMARA_PROVIDER=true
ENABLE_SENADO_PROVIDER=true
