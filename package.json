{
  "name": "lex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:enum-providers": "tsx --env-file=.env scripts/migrate-enum-providers.ts",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "qdrant:init": "tsx --env-file=.env scripts/init-qdrant.ts",
    "redis:check": "tsx --env-file=.env scripts/redis-check.ts",
    "ingest:corpus": "tsx --env-file=.env seed/ingest-corpus.ts",
    "corpus:sync": "tsx --env-file=.env scripts/corpus-sync.ts",
    "corpus:seed": "tsx --env-file=.env scripts/corpus-seed.ts",
    "corpus:seed:fixture": "tsx --env-file=.env scripts/corpus-seed.ts -- --provider=FIXTURE",
    "corpus:seed:lexml": "tsx --env-file=.env scripts/corpus-seed.ts -- --provider=LEXML",
    "corpus:seed:lexml:dry": "tsx --env-file=.env scripts/corpus-seed.ts -- --provider=LEXML --dry-run",
    "corpus:seed:stf": "tsx --env-file=.env scripts/corpus-seed.ts -- --provider=STF",
    "corpus:seed:stf:dry": "tsx --env-file=.env scripts/corpus-seed.ts -- --provider=STF --dry-run",
    "corpus:seed:stj": "tsx --env-file=.env scripts/corpus-seed.ts -- --provider=STJ",
    "corpus:seed:stj:dry": "tsx --env-file=.env scripts/corpus-seed.ts -- --provider=STJ --dry-run",
    "corpus:seed:all-public": "tsx --env-file=.env scripts/corpus-seed.ts -- --provider=all-public",
    "corpus:seed:all-public:dry": "tsx --env-file=.env scripts/corpus-seed.ts -- --provider=all-public --dry-run",
    "corpus:stats": "tsx --env-file=.env scripts/corpus-stats.ts",
    "datajud:check": "tsx --env-file=.env scripts/datajud-check.ts",
    "datajud:dry-run": "tsx --env-file=.env scripts/datajud-check.ts -- --dry-run",
    "retrieval:smoke": "tsx --env-file=.env scripts/retrieval-smoke.ts",
    "seed:demo-legal": "tsx --env-file=.env seed/seed-demo-legal.ts",
    "smoke:team": "tsx --env-file=.env scripts/smoke-team.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:smoke": "vitest run --passWithNoTests --reporter=basic",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run lint && npm run typecheck && npm run test && NODE_ENV=production npm run build && npm run test:e2e",
    "ci": "npm run lint && npm run typecheck && npm run test && NODE_ENV=production npm run build",
    "infra:up": "docker compose -f docker/docker-compose.yml up -d redis qdrant mailhog",
    "infra:down": "docker compose -f docker/docker-compose.yml down",
    "infra:logs": "docker compose -f docker/docker-compose.yml logs -f --tail=100",
    "health": "curl -fsS http://localhost:3000/api/health | jq . || curl -fsS http://localhost:3000/api/health",
    "ready": "curl -fsS http://localhost:3000/api/ready | jq . || curl -fsS http://localhost:3000/api/ready",
    "dev:full": "npm run infra:up && npm run dev",
    "deploy:check": "tsx --env-file=.env scripts/deploy-check.ts",
    "production:check": "tsx --env-file=.env.production scripts/deploy-check.ts",
    "vercel:check": "tsx scripts/deploy-check.ts",
    "inngest:check": "tsx scripts/inngest-check.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/openai": "^1.3.24",
    "@ai-sdk/react": "^1.2.12",
    "@hookform/resolvers": "^5.0.1",
    "@prisma/client": "^6.8.2",
    "@qdrant/js-client-rest": "^1.14.1",
    "@radix-ui/react-accordion": "^1.2.10",
    "@radix-ui/react-alert-dialog": "^1.1.13",
    "@radix-ui/react-avatar": "^1.1.9",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.13",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.76.1",
    "@tanstack/react-virtual": "^3.13.9",
    "@tiptap/extension-placeholder": "^2.12.0",
    "@tiptap/pm": "^2.12.0",
    "@tiptap/react": "^2.12.0",
    "@tiptap/starter-kit": "^2.12.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "ai": "^4.3.16",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "framer-motion": "^12.12.1",
    "inngest": "^3.35.0",
    "ioredis": "^5.10.1",
    "langfuse": "^3.38.20",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.9.0",
    "nanoid": "^5.1.5",
    "next": "^15.3.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.5.3",
    "prisma": "^6.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.56.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^6.0.1",
    "typescript": "^5.8.3",
    "zod": "^3.24.4",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.59.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "shiki": "^3.4.2",
    "tsx": "^4.19.4",
    "vitest": "^3.1.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  }
}

