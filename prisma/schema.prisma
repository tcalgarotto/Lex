generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  LAWYER
  ASSISTANT
  CLIENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DocumentStatus {
  UPLOADED
  PARSING
  CHUNKING
  EMBEDDING
  INDEXED
  FAILED
}

/**
 * Biblioteca do workspace:
 * - SHARED_* — catálogo partilhado com todos os membros (fileiras Leis/Códigos/Normas e Livros recomendados).
 * - OFFICE_PRIVATE — documento privado; em ficheiros soltos só o remetente lê (além de admins).
 */
enum DocumentLibraryShelf {
  OFFICE_PRIVATE
  SHARED_LEGAL
  SHARED_BOOKS
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MemoryKind {
  PROCESS
  CLIENT
  STRATEGY
  THESIS
  STYLE_NOTE
}

enum LegalLayer {
  legislation
  jurisprudence
  user_documents
  legal_pieces
  process_memory
  style_examples
}

/**
 * Classificação semântica do trecho (não indexar PDF cru — sempre texto estruturado).
 */
enum LegalChunkSection {
  preliminaries
  facts
  grounds
  legal_reasoning
  case_law
  requests
  dispositive
  thesis
  article_norm
  generic
}

enum CostCategory {
  EMBEDDING
  CHAT_COMPLETION
  COMPLETION
  RETRIEVAL
  STORAGE
  OTHER
}

enum JobRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum LegalProcessDataJudStatus {
  ACTIVE
  NOT_FOUND
  UNAVAILABLE
  ERROR
  DISABLED
}

enum LegalProcessSyncStatus {
  SUCCESS
  NOT_FOUND
  ERROR
  SKIPPED
}

enum LegalProcessSyncSource {
  MANUAL
  DAILY
  AUTOCOMPLETE
  IMPORT
}

enum LegalProcessAlertType {
  NEW_MOVEMENT
  ATTENTION
  STALE_PROCESS
  SYNC_FAILED
  DATAJUD_UNAVAILABLE
}

enum LegalProcessAlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LegalProcessAlertStatus {
  OPEN
  ACKED
  RESOLVED
}

enum CourtConnectorType {
  DATAJUD_PUBLIC
  ESCRITORIO_DIGITAL
  MNI
  DOMICILIO_JUDICIAL
  DJEN
  OFFICIAL_GAZETTE
  TRIBUNAL_PUBLIC_QUERY
  PJE
  ESAJ
  EPROC
  PROJUDI
  MANUAL_UPLOAD
  MANUAL_PASTE
}

enum CourtConnectorStatus {
  active
  available
  pending_credentials
  requires_user_login
  requires_certificate
  requires_official_authorization
  public_read_only
  manual_bridge
  unavailable
  planned
  disabled
  blocked
}

enum CourtConnectionAuthType {
  NONE
  OFFICIAL_OAUTH
  OFFICIAL_TOKEN
  CERTIFICATE_TOKEN
  MANUAL
}

enum OfficialCommunicationSource {
  DOMICILIO_JUDICIAL
  DJEN
  ESCRITORIO_DIGITAL
  OFFICIAL_GAZETTE
  TRIBUNAL_PUBLIC_QUERY
  MANUAL
  OTHER_OFFICIAL
}

enum OfficialCommunicationType {
  CITACAO
  INTIMACAO
  OFICIO
  AUDIENCIA
  PUBLICACAO
  OUTRO
}

enum OfficialCommunicationStatus {
  NEEDS_REVIEW
  REVIEWED
  DISCARDED
}

model User {
  id                        String              @id @default(cuid())
  email                     String              @unique
  name                      String?
  avatarUrl                 String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  memberships               Membership[]
  styleProfiles             StyleProfile[]
  libraryFoundationsCreated LibraryFoundation[] @relation("LibraryFoundationCreatedBy")
  libraryFoundationsOwned   LibraryFoundation[] @relation("LibraryFoundationOwnerUser")
  officeMemoriesOwned       OfficeMemory[]      @relation("OfficeMemoryOwnerUser")
  officeMemoriesCreated     OfficeMemory[]      @relation("OfficeMemoryCreatedBy")
  officeMemoriesUpdated     OfficeMemory[]      @relation("OfficeMemoryUpdatedBy")
  documentsUploaded         Document[]          @relation("DocumentUploadedBy")
  calendarEventsCreated     CalendarEvent[]     @relation("CalendarEventCreator")
  calendarEventsAssigned    CalendarEvent[]     @relation("CalendarEventAssignee")
}

enum WorkspaceLicense {
  /**
   * 3 lugares (membros + convites pendentes).
   */
  INVESTOR
  /**
   * 1 lugar — só o titular da assinatura.
   */
  SOLO
  /**
   * 2 lugares.
   */
  DUO
  /**
   * 4 lugares.
   */
  TEAM
  /**
   * Empresarial: `customSeatLimit` null = ilimitado até a equipa de vendas definir;
   * com valor = limite máximo de membros+pendentes.
   */
  ENTERPRISE
}

model Workspace {
  id                       String                    @id @default(cuid())
  name                     String
  slug                     String                    @unique
  onboardingCompleted      Boolean                   @default(false)
  onboardingJson           Json?
  /**
   * Plano contratado do workspace. É **mutável**: após confirmação de pagamento
   * (ex.: webhook) pode subir (Solo → Duo) ou descer, com efeito imediato nos
   * limites de lugares; rebaixar exige que membros+pendentes caibam no novo teto.
   */
  license                  WorkspaceLicense          @default(ENTERPRISE)
  /**
   * Só para `ENTERPRISE`: limite negociado; `null` = ilimitado até vendas fixar.
   * Em outros planos deve ser `null`.
   */
  customSeatLimit          Int?
  /**
   * Quota de armazenamento (bytes) para documentos do workspace na nuvem Lex.
   * Padrão comercial: 2 GiB. Planos futuros podem elevar via billing ou override.
   */
  storageQuotaBytes        BigInt                    @default(2147483648)
  /**
   * Uso agregado (soma dos `Document.sizeBytes` ativos). Atualizado após uploads
   * e exclusões; `recalculateWorkspaceStorageUsage` reconcilia com a soma real.
   */
  storageUsedBytes         BigInt                    @default(0)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  memberships              Membership[]
  clients                  Client[]
  processes                Process[]
  documents                Document[]
  threads                  ChatThread[]
  pieces                   LegalPiece[]
  memories                 MemoryEntry[]
  styles                   StyleProfile[]
  jobs                     JobRun[]
  activities               Activity[]
  costEntries              CostLedgerEntry[]
  observabilityLogs        ObservabilityLog[]
  feedbacks                FeedbackEntry[]
  invitations              Invitation[]
  cases                    Case[]
  integrations             Integration[]
  notifications            Notification[]
  alerts                   CaseAlert[]
  legalProcesses           LegalProcess[]
  legalProcessMovements    LegalProcessMovement[]
  legalProcessSyncLogs     LegalProcessSyncLog[]
  legalProcessAlerts       LegalProcessAlert[]
  courtConnections         CourtConnection[]
  courtConnectionAuditLogs CourtConnectionAuditLog[]
  officialCommunications   OfficialCommunication[]
  libraryFoundations       LibraryFoundation[]
  officeMemories           OfficeMemory[]
  calendarEvents           CalendarEvent[]
  crmContacts              CrmContact[]
  crmConversations         CrmConversation[]
  crmMessages              CrmMessage[]
  crmActivities            CrmActivity[]
  justosWhatsappSession    JustosWhatsappSession?
}

enum LibraryFoundationScope {
  WORKSPACE
  USER
}

/**
 * F19 — Memória curada (opt-in): texto reutilizável por workspace, usuário ou caso.
 * Nada é promovido automaticamente para cá.
 */
enum OfficeMemoryScope {
  WORKSPACE
  USER
  CASE
}

model LibraryFoundation {
  id          String                 @id @default(cuid())
  workspaceId String
  scope       LibraryFoundationScope @default(WORKSPACE)
  ownerUserId String?
  title       String
  contentMd   String                 @db.Text
  tags        String[]               @default([])
  sourceJson  Json?
  optInSearch Boolean                @default(false) @map("optInRag")
  optInMemory Boolean                @default(false)
  useAsModel  Boolean                @default(false)
  useAsStyle  Boolean                @default(false)
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerUser   User?                  @relation("LibraryFoundationOwnerUser", fields: [ownerUserId], references: [id])
  createdBy   User?                  @relation("LibraryFoundationCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, updatedAt])
}

model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        MembershipRole   @default(LAWYER)
  /**
   * Token opaco (~32 bytes hex) enviado no link. Único globalmente.
   */
  token       String           @unique
  invitedById String
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  acceptedBy  String?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email, status])
  @@index([workspaceId])
  @@index([email])
}

model Membership {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  role        MembershipRole @default(LAWYER)
  createdAt   DateTime       @default(now())
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Client {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  documentId  String?
  email       String?
  phone       String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  processes   Process[]
  crmContacts CrmContact[]

  @@index([workspaceId])
}

model Process {
  id                     String                  @id @default(cuid())
  workspaceId            String
  clientId               String?
  number                 String
  title                  String?
  vara                   String?
  tribunal               String?
  observations           String?
  tags                   String[]                @default([])
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client                 Client?                 @relation(fields: [clientId], references: [id])
  documents              Document[]
  threads                ChatThread[]
  pieces                 LegalPiece[]
  memories               MemoryEntry[]
  timeline               ProcessTimelineEvent[]
  legalProcesses         LegalProcess[]
  feedbacks              FeedbackEntry[]
  officialCommunications OfficialCommunication[]
  calendarEvents         CalendarEvent[]
  /**
   * Backref: Case.processId? aponta pra cá (1:1 opcional).
   */
  case                   Case?

  @@index([workspaceId])
  @@index([workspaceId, number])
}

model Document {
  id                     String                  @id @default(cuid())
  workspaceId            String
  processId              String?
  /**
   * Vínculo opcional ao Case (jornada centrada em caso). Coexiste com
   * `processId` (legado, /processos). Um documento pode estar standalone,
   * vinculado a um Process, vinculado a um Case, ou ambos.
   */
  caseId                 String?
  /**
   * Quem enviou o ficheiro (auditoria e documentos privados OFFICE_PRIVATE).
   * Catálogo global da plataforma: pode ser `null` (scripts para `lex-platform-catalog`).
   */
  uploadedByUserId       String?
  /**
   * Prateleira na biblioteca: catálogo partilhado vs. privado do escritório.
   */
  libraryShelf           DocumentLibraryShelf    @default(OFFICE_PRIVATE)
  originalName           String
  mimeType               String
  sizeBytes              Int
  storagePath            String
  status                 DocumentStatus          @default(UPLOADED)
  errorMessage           String?
  /**
   * Texto extraído (para viewer e debug); pode ser truncado.
   */
  extractedText          String?                 @db.Text
  extractedAt            DateTime?
  /**
   * Progresso aproximado 0..1 para UX (pipeline async).
   */
  progress               Float                   @default(0)
  totalChunks            Int?
  processedChunks        Int?
  indexedAt              DateTime?
  /**
   * F11 — Soft delete: arquivar/restaurar + excluir definitivo.
   * - archivedAt: ocultar da UI padrão, mantendo histórico.
   * - deletedAt: marcação para exclusão definitiva (API remove storage + chunks).
   */
  archivedAt             DateTime?
  deletedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  process                Process?                @relation(fields: [processId], references: [id])
  case                   Case?                   @relation(fields: [caseId], references: [id])
  uploadedBy             User?                   @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  chunks                 DocumentChunk[]
  officialCommunications OfficialCommunication[]
  calendarEvents         CalendarEvent[]

  @@index([workspaceId])
  @@index([processId])
  @@index([caseId])
  @@index([status])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, libraryShelf])
  @@index([uploadedByUserId])
}

model DocumentChunk {
  id            String            @id @default(cuid())
  documentId    String
  chunkIndex    Int
  text          String            @db.Text
  textPreview   String            @db.Text
  section       LegalChunkSection @default(generic)
  contentHash   String?
  qdrantPointId String?
  tokenEstimate Int?
  createdAt     DateTime          @default(now())
  document      Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([contentHash])
}

model ChatThread {
  id          String        @id @default(cuid())
  workspaceId String
  processId   String
  title       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  process     Process       @relation(fields: [processId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@unique([processId])
  @@index([workspaceId])
}

model ChatMessage {
  id            String     @id @default(cuid())
  threadId      String
  role          ChatRole
  content       String     @db.Text
  citationsJson Json?
  reasoningJson Json?
  createdAt     DateTime   @default(now())
  thread        ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model LegalPiece {
  id          String    @id @default(cuid())
  workspaceId String
  processId   String?
  kind        String
  title       String
  contentJson Json
  /**
   * Metadados de geração (fontes, confiança, avisos) para painel do editor.
   */
  aiMetaJson  Json?
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  process     Process?  @relation(fields: [processId], references: [id])

  @@index([workspaceId])
  @@index([processId])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, deletedAt])
}

model MemoryEntry {
  id          String     @id @default(cuid())
  workspaceId String
  processId   String?
  kind        MemoryKind
  title       String?
  content     String     @db.Text
  embeddingId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  process     Process?   @relation(fields: [processId], references: [id])

  @@index([workspaceId])
  @@index([processId])
}

model StyleProfile {
  id               String    @id @default(cuid())
  workspaceId      String
  userId           String?
  profileJson      Json
  recurringPhrases String[]  @default([])
  metricsJson      Json?
  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User?     @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@index([workspaceId])
}

model JobRun {
  id           String       @id @default(cuid())
  workspaceId  String?
  inngestRunId String?
  name         String
  status       JobRunStatus @default(PENDING)
  payloadJson  Json?
  errorMessage String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([status])
}

model Activity {
  id          String    @id @default(cuid())
  workspaceId String
  kind        String
  title       String
  metaJson    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdAt])
}

model FeedbackEntry {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  processId   String?
  rating      Int
  comment     String?  @db.Text
  difficulty  String?
  highlight   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  process   Process?  @relation(fields: [processId], references: [id])

  @@index([workspaceId])
  @@index([createdAt])
}

model ProcessTimelineEvent {
  id          String   @id @default(cuid())
  processId   String
  title       String
  description String?  @db.Text
  occurredAt  DateTime @default(now())
  metaJson    Json?
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
}

model LegalProcess {
  id                        String                    @id @default(cuid())
  workspaceId               String
  caseId                    String?
  processId                 String?
  cnj                       String
  cnjFormatted              String
  tribunalAcronym           String
  tribunalAlias             String
  branch                    String
  grau                      String?
  classeCodigo              String?
  classeNome                String?
  assuntosJson              Json?
  dataAjuizamento           DateTime?
  orgaoJulgadorCodigo       String?
  orgaoJulgadorNome         String?
  sistemaCodigo             String?
  sistemaNome               String?
  formatoCodigo             String?
  formatoNome               String?
  nivelSigilo               Int?
  dataHoraUltimaAtualizacao DateTime?
  lastDataJudSyncAt         DateTime?
  dataJudStatus             LegalProcessDataJudStatus @default(ACTIVE)
  dataJudRawJson            Json?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  case                   Case?                   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  process                Process?                @relation(fields: [processId], references: [id], onDelete: SetNull)
  movements              LegalProcessMovement[]
  syncLogs               LegalProcessSyncLog[]
  alerts                 LegalProcessAlert[]
  officialCommunications OfficialCommunication[]
  calendarEvents         CalendarEvent[]

  @@unique([workspaceId, cnj])
  @@index([workspaceId, caseId])
  @@index([processId])
  @@index([workspaceId, dataJudStatus])
  @@index([workspaceId, lastDataJudSyncAt])
  @@index([tribunalAcronym])
  @@index([tribunalAlias])
}

model LegalProcessMovement {
  id                String    @id @default(cuid())
  workspaceId       String
  legalProcessId    String
  codigo            String?
  nome              String
  dataHora          DateTime?
  category          String    @default("outros")
  complementosJson  Json?
  orgaoJulgadorJson Json?
  movementHash      String
  rawJson           Json?
  createdAt         DateTime  @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  legalProcess LegalProcess @relation(fields: [legalProcessId], references: [id], onDelete: Cascade)

  @@unique([legalProcessId, movementHash])
  @@index([workspaceId])
  @@index([legalProcessId, dataHora])
  @@index([legalProcessId, category])
}

model LegalProcessSyncLog {
  id             String                 @id @default(cuid())
  workspaceId    String
  legalProcessId String?
  cnj            String
  tribunalAlias  String
  status         LegalProcessSyncStatus
  source         LegalProcessSyncSource
  startedAt      DateTime               @default(now())
  finishedAt     DateTime?
  errorCode      String?
  errorMessage   String?                @db.Text
  resultCount    Int                    @default(0)
  rawMetaJson    Json?

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  legalProcess LegalProcess? @relation(fields: [legalProcessId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, status, startedAt])
  @@index([legalProcessId, startedAt])
  @@index([workspaceId, cnj])
}

model LegalProcessAlert {
  id             String                    @id @default(cuid())
  workspaceId    String
  legalProcessId String
  type           LegalProcessAlertType
  severity       LegalProcessAlertSeverity @default(INFO)
  title          String
  description    String                    @db.Text
  status         LegalProcessAlertStatus   @default(OPEN)
  fingerprint    String
  payloadJson    Json?
  createdAt      DateTime                  @default(now())
  resolvedAt     DateTime?

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  legalProcess LegalProcess @relation(fields: [legalProcessId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, fingerprint])
  @@index([workspaceId, status, severity])
  @@index([legalProcessId, status])
  @@index([workspaceId, type, createdAt])
}

model CourtConnection {
  id              String                  @id @default(cuid())
  workspaceId     String
  provider        CourtConnectorType
  status          CourtConnectorStatus
  authType        CourtConnectionAuthType @default(NONE)
  encryptedToken  String?                 @db.Text
  scopesJson      Json?
  lastConnectedAt DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  workspace Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditLogs CourtConnectionAuditLog[]

  @@unique([workspaceId, provider])
  @@index([workspaceId, status])
  @@index([workspaceId, provider, status])
}

model CourtConnectionAuditLog {
  id           String   @id @default(cuid())
  workspaceId  String
  connectionId String?
  action       String
  status       String
  createdAt    DateTime @default(now())
  metadataJson Json?

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection CourtConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([connectionId, createdAt])
}

model OfficialCommunication {
  id                String                      @id @default(cuid())
  workspaceId       String
  legalProcessId    String?
  processId         String?
  caseId            String?
  documentId        String?
  source            OfficialCommunicationSource
  communicationType OfficialCommunicationType   @default(OUTRO)
  receivedAt        DateTime?
  availableAt       DateTime?
  readAt            DateTime?
  dueReviewAt       DateTime?
  status            OfficialCommunicationStatus @default(NEEDS_REVIEW)
  title             String
  description       String?                     @db.Text
  rawText           String?                     @db.Text
  createdByUserId   String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  legalProcess LegalProcess? @relation(fields: [legalProcessId], references: [id], onDelete: SetNull)
  process      Process?      @relation(fields: [processId], references: [id], onDelete: SetNull)
  case         Case?         @relation(fields: [caseId], references: [id], onDelete: SetNull)
  document     Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, dueReviewAt])
  @@index([workspaceId, source, createdAt])
  @@index([legalProcessId])
  @@index([processId])
  @@index([caseId])
  @@index([documentId])
}

enum CalendarEventType {
  CLIENT_MEETING
  HEARING
  REVIEW_DEADLINE
  REVIEW_COMMUNICATION
  FOLLOW_UP
  INTERNAL_TASK
  OTHER
}

enum CalendarEventStatus {
  PENDING
  DONE
  CANCELLED
}

enum CalendarEventSource {
  MANUAL
  OFFICIAL_COMMUNICATION
  OTHER
}

/**
 * P1 — Agenda jurídica interna (sem Google Calendar). Multi-tenant por workspace.
 */
model CalendarEvent {
  id                    String              @id @default(cuid())
  workspaceId           String
  caseId                String?
  legalProcessId        String?
  processId             String?
  documentId            String?
  title                 String
  description           String?             @db.Text
  /**
   * Local físico ou sala (UI agenda LEX / schedule).
   */
  location              String?
  eventType             CalendarEventType   @default(OTHER)
  status                CalendarEventStatus @default(PENDING)
  startsAt              DateTime
  endsAt                DateTime?
  allDay                Boolean             @default(false)
  timezone              String              @default("America/Sao_Paulo")
  assignedToUserId      String?
  createdByUserId       String
  source                CalendarEventSource @default(MANUAL)
  sourceRefId           String?
  /**
   * Quando o evento vem de comunicação oficial, exige revisão humana (não gera prazo automático).
   */
  requiresHumanReview   Boolean             @default(false)
  reminderMinutesBefore Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  case         Case?         @relation(fields: [caseId], references: [id], onDelete: SetNull)
  legalProcess LegalProcess? @relation(fields: [legalProcessId], references: [id], onDelete: SetNull)
  process      Process?      @relation(fields: [processId], references: [id], onDelete: SetNull)
  document     Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  assignedTo   User?         @relation("CalendarEventAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("CalendarEventCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startsAt])
  @@index([workspaceId, status, startsAt])
  @@index([caseId, startsAt])
  @@index([legalProcessId, startsAt])
  @@index([processId, startsAt])
  @@index([documentId])
  @@index([assignedToUserId, startsAt])
}

model CostLedgerEntry {
  id               String       @id @default(cuid())
  workspaceId      String
  userId           String?
  category         CostCategory
  provider         String
  model            String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  costUsd          Float?
  unitQuantity     Int?
  metaJson         Json?
  createdAt        DateTime     @default(now())
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, category])
  @@index([createdAt])
}

model ObservabilityLog {
  id                String    @id @default(cuid())
  workspaceId       String
  userId            String?
  traceId           String?
  kind              String
  name              String?
  payloadJson       Json?
  retrievalChunkIds Json?
  latencyMs         Int
  errorMessage      String?
  createdAt         DateTime  @default(now())
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind])
  @@index([createdAt])
}

// ============================================================================
// CORPUS JURÍDICO NACIONAL — entidades canônicas, multi-provider, temporal.
// Compartilhadas por TODOS os workspaces (tenant = "__global__" no Qdrant).
// ============================================================================

/**
 * Tipo da norma jurídica. Categorização canônica orientada a recuperação.
 */
enum NormKind {
  CONSTITUTION
  CONSTITUTIONAL_AMENDMENT
  COMPLEMENTARY_LAW
  ORDINARY_LAW
  DELEGATED_LAW
  PROVISIONAL_MEASURE
  DECREE_LAW
  DECREE
  RESOLUTION
  PORTARIA
  NORMATIVE_INSTRUCTION
  CIRCULAR
  CODE
  REGIMENT
  JURISPRUDENCE_STF
  JURISPRUDENCE_STJ
  JURISPRUDENCE_TST
  JURISPRUDENCE_OTHER
  SUMULA_STF
  SUMULA_STJ
  SUMULA_VINCULANTE
  REPETITIVE_THEME
  OTHER
}

/**
 * Esfera/poder ao qual a norma pertence.
 */
enum NormJurisdiction {
  FEDERAL
  STATE
  MUNICIPAL
  DISTRITAL
  INTERNATIONAL
  AGENCY
  COURT
  UNKNOWN
}

/**
 * Status temporal/eficacial da norma.
 */
enum NormStatus {
  ACTIVE
  REVOKED
  SUSPENDED
  SUPERSEDED
  DRAFT
  UNKNOWN
}

/**
 * Provedor de origem do dado.
 */
enum CorpusProvider {
  LEXML
  STF
  STJ
  TST
  PLANALTO
  DATAJUD
  CAMARA
  SENADO
  MANUAL
  FIXTURE
}

/**
 * Tipo de aresta no grafo de citações entre normas.
 */
enum CitationKind {
  CITES
  REFERENCED_BY
  REVOKES
  REVOKED_BY
  AMENDS
  AMENDED_BY
  REGULATES
  REGULATED_BY
  OVERRULES
  OVERRULED_BY
  RELATES_TO
}

/**
 * Posição estrutural do chunk dentro da hierarquia jurídica brasileira.
 */
enum LegalStructure {
  EMENTA
  PREAMBULO
  PARTE
  LIVRO
  TITULO
  CAPITULO
  SECAO
  SUBSECAO
  ARTIGO
  CAPUT
  PARAGRAFO
  INCISO
  ALINEA
  ITEM
  ANEXO
  NOTE
  GENERIC
}

enum IngestionJobStatus {
  PENDING
  RUNNING
  PARTIAL
  COMPLETED
  FAILED
}

/**
 * Entidade canônica de norma jurídica (lei, decreto, súmula, acórdão...).
 * Identificada UNICAMENTE pela URN-LEX. Provider é metadado de origem.
 */
model LegalNorm {
  id               String           @id @default(cuid())
  /**
   * URN-LEX canônica. Ex.: "urn:lex:br:federal:lei:1990-09-11;8078"
   */
  urn              String           @unique
  kind             NormKind
  jurisdiction     NormJurisdiction @default(UNKNOWN)
  status           NormStatus       @default(ACTIVE)
  /**
   * Curto, ex.: "Código de Defesa do Consumidor".
   */
  title            String           @db.Text
  /**
   * Identificador "humano", ex.: "Lei nº 8.078/1990".
   */
  identifier       String?
  /**
   * Tribunal ou autoridade emissora (para jurisprudência/atos).
   */
  authority        String?
  /**
   * Sigla do tribunal (STJ, STF, TST, TRF1…) quando aplicável.
   */
  tribunal         String?
  /**
   * Relator de acórdão / autor de PL.
   */
  rapporteur       String?
  /**
   * Ementa (quando há), independente de version.
   */
  ementa           String?          @db.Text
  publishedAt      DateTime?
  effectiveAt      DateTime?
  revokedAt        DateTime?
  /**
   * Idioma ISO-639-1, default pt-BR.
   */
  language         String           @default("pt-BR")
  /**
   * Tags livres para classificação adicional.
   */
  tags             String[]         @default([])
  /**
   * Provedor que originou / mantém esta norma.
   */
  sourceProvider   CorpusProvider
  /**
   * URL canônica para o documento original (Planalto, DJE…).
   */
  sourceUrl        String?
  /**
   * Identificador opaco do provedor (ex.: oai-id, processo no STJ).
   */
  sourceExternalId String?
  /**
   * Última checagem/fetch contra a fonte.
   */
  lastFetchedAt    DateTime?
  /**
   * ETag/Last-Modified para HTTP conditional GET.
   */
  etag             String?
  lastModifiedAt   DateTime?
  /**
   * Hash do payload mais recente (decide se reprocessamos).
   */
  contentHash      String?
  /**
   * Estrutura hierárquica resumida (índice, quando disponível).
   */
  hierarchyJson    Json?
  metadataJson     Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  versions      LegalNormVersion[]
  chunks        LegalChunk[]
  citationsFrom LegalCitation[]    @relation("citationsFrom")
  citationsTo   LegalCitation[]    @relation("citationsTo")

  @@index([kind])
  @@index([jurisdiction])
  @@index([status])
  @@index([sourceProvider])
  @@index([publishedAt])
  @@index([tribunal])
}

/**
 * Versão temporal da norma. Cada alteração relevante (redação atualizada,
 * revogação parcial) gera uma nova versão. Permite recuperação por data.
 */
model LegalNormVersion {
  id            String    @id @default(cuid())
  normId        String
  /**
   * Início de vigência desta versão.
   */
  validFrom     DateTime
  /**
   * Fim de vigência (null = vigente).
   */
  validTo       DateTime?
  /**
   * Hash sha256 do conteúdo desta versão. Imutável.
   */
  contentHash   String
  /**
   * Texto bruto canônico desta versão.
   */
  rawText       String    @db.Text
  /**
   * HTML/XML original (quando disponível).
   */
  htmlSource    String?   @db.Text
  /**
   * Estrutura hierárquica desta versão (árvore JSON tipada).
   */
  structureJson Json?
  metadataJson  Json?
  createdAt     DateTime  @default(now())

  norm   LegalNorm    @relation(fields: [normId], references: [id], onDelete: Cascade)
  chunks LegalChunk[]

  @@unique([normId, validFrom])
  @@unique([normId, contentHash])
  @@index([normId])
  @@index([validFrom])
}

/**
 * Chunk indexável jurídico (separado do `DocumentChunk` user-side).
 * Carrega lineage completo: norma + versão + estrutura hierárquica.
 */
model LegalChunk {
  id             String                   @id @default(cuid())
  normId         String
  normVersionId  String
  /**
   * Posição estável (0..N) dentro da versão da norma.
   */
  ordinal        Int
  structure      LegalStructure           @default(GENERIC)
  /**
   * Caminho hierárquico completo, ex.: "Art. 5º, § 2º, II, b".
   */
  fullPath       String?
  articleRef     String?
  paragraphRef   String?
  incisoRef      String?
  alineaRef      String?
  text           String                   @db.Text
  /**
   * Hash do texto pra dedup e cache de embeddings.
   */
  contentHash    String
  tokenEstimate  Int?
  /**
   * Id do ponto correspondente em Qdrant.
   */
  vectorPointId  String?
  /**
   * Versão do esquema do chunker (lineage).
   */
  chunkerVersion String                   @default("v2")
  /**
   * F3.5 — Quando este chunk é "filho" (inciso/§/alínea recortados de um
   * artigo longo pelo chunker v3), aponta para o chunk-pai (o artigo
   * inteiro). null para chunks-pai e v2.
   */
  parentChunkId  String?
  metadataJson   Json?
  createdAt      DateTime                 @default(now())
  /**
   * Vetor textual gerado para BM25 (Postgres FTS). Coluna criada via migration
   * SQL como `GENERATED ALWAYS AS (to_tsvector('portuguese', text)) STORED`,
   * com índice GIN. Mapeada como Unsupported aqui porque Prisma não tem o tipo.
   */
  textTsv        Unsupported("tsvector")?

  norm    LegalNorm        @relation(fields: [normId], references: [id], onDelete: Cascade)
  version LegalNormVersion @relation(fields: [normVersionId], references: [id], onDelete: Cascade)

  @@unique([normVersionId, ordinal])
  @@index([normId])
  @@index([structure])
  @@index([articleRef])
  @@index([contentHash])
}

/**
 * Aresta direcionada do grafo de citações entre normas.
 * `targetUrn` permite registrar citação antes da norma destino existir
 * (resolvemos o `targetNormId` quando ela aparecer no corpus).
 */
model LegalCitation {
  id            String       @id @default(cuid())
  sourceNormId  String
  /**
   * Pode ser nulo até resolver o destino (lazy).
   */
  targetNormId  String?
  /**
   * URN destino, sempre preenchida. Index pra resolver depois.
   */
  targetUrn     String
  /**
   * Texto bruto da citação como apareceu na fonte.
   */
  rawText       String?      @db.Text
  kind          CitationKind @default(CITES)
  /**
   * Chunk de origem (de qual trecho extraímos a citação).
   */
  sourceChunkId String?
  /**
   * Confiança 0..1 da extração (regex vs LLM-resolved).
   */
  confidence    Float        @default(0.8)
  metadataJson  Json?
  createdAt     DateTime     @default(now())

  source LegalNorm  @relation("citationsFrom", fields: [sourceNormId], references: [id], onDelete: Cascade)
  target LegalNorm? @relation("citationsTo", fields: [targetNormId], references: [id])

  @@index([sourceNormId])
  @@index([targetNormId])
  @@index([targetUrn])
  @@index([kind])
}

/**
 * Cursor de sincronização incremental por (provider, kind).
 */
model IngestionWatermark {
  id           String         @id @default(cuid())
  provider     CorpusProvider
  kind         NormKind
  /**
   * Cursor opaco (data ISO, oai resumption token, page).
   */
  cursor       String?
  lastSyncAt   DateTime?
  itemsTotal   Int            @default(0)
  metadataJson Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([provider, kind])
}

/**
 * Auditoria por execução. Permite reprocessar e diagnosticar.
 */
model IngestionJob {
  id             String             @id @default(cuid())
  provider       CorpusProvider
  kind           NormKind?
  status         IngestionJobStatus @default(PENDING)
  cursor         String?
  startedAt      DateTime           @default(now())
  finishedAt     DateTime?
  itemsProcessed Int                @default(0)
  itemsCreated   Int                @default(0)
  itemsUpdated   Int                @default(0)
  itemsSkipped   Int                @default(0)
  itemsFailed    Int                @default(0)
  errorMessage   String?            @db.Text
  metadataJson   Json?

  @@index([provider, status])
  @@index([startedAt])
}

/**
 * -----------------------------------------------------------------------
 */
/**
 * Legal Workflow Automation
 */
/**
 * -----------------------------------------------------------------------
 */

enum CaseStatus {
  INTAKE
  RESEARCH
  DRAFTING
  REVIEW
  READY
  FILED
  CLOSED
  ARCHIVED
}

enum CasePartyRole {
  AUTHOR
  DEFENDANT
  INTERVENING
  OTHER
}

enum CasePartyKind {
  PERSON
  COMPANY
  PUBLIC_ENTITY
  UNKNOWN
}

enum CaseRequestKind {
  MAIN
  SUBSIDIARY
  URGENCY
  PROVISIONAL
  EVIDENCE
  PROCEDURAL
  OTHER
}

enum CaseRiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseRiskKind {
  REVOKED_NORM
  PRECEDENT_DIVERGENCE
  HISTORIC_VERSION
  MISSING_GROUNDING
  WEAK_ARGUMENT
  PROCEDURAL_GAP
  /**
   * F4.5 — Inconsistência detectada entre dados do brain e dados extraídos
   * de documentos (nomes, CPF, datas, idades, cidade). Atribui evidência
   * com chunk(s) de origem.
   */
  DOCUMENT_INCONSISTENCY
  OTHER
}

enum CaseDraftStatus {
  PENDING
  GENERATED
  EDITED
  APPROVED
}

enum CaseTimelineKind {
  CASE_CREATED
  INTAKE_COMPLETED
  RESEARCH_RUN
  DRAFT_GENERATED
  DRAFT_EDITED
  REVIEW_RUN
  RISK_FLAGGED
  STATUS_CHANGED
  NOTE
  STRATEGY_GENERATED
  BRAIN_GENERATED
  DOCUMENT_INCONSISTENCY
}

/**
 * Caso jurídico em workflow do Lex (multi-tenant por workspaceId).
 */
model Case {
  id            String     @id @default(cuid())
  workspaceId   String
  createdById   String
  /**
   * Título humano (autocompletado pelo intake).
   */
  title         String
  /**
   * Resumo curto (1-2 linhas). Gerado deterministicamente no intake.
   */
  summary       String?    @db.Text
  /**
   * Texto bruto inicial enviado pelo advogado.
   */
  rawInput      String     @db.Text
  status        CaseStatus @default(INTAKE)
  /**
   * Tribunal alvo (registry code, ex.: TJSP, TRF3). Opcional.
   */
  tribunalCode  String?
  /**
   * UF principal do caso.
   */
  uf            String?
  /**
   * Numero do processo, se já existir.
   */
  processNumber String?
  /**
   * Ponte 1:1 opcional para um Process interno do Lex (/processos). Quando
   * presente, documentos do Process aparecem dentro do Case (na aba
   * Documentos) e vice-versa. Não migramos automaticamente Process → Case.
   */
  processId     String?    @unique
  metadataJson  Json?
  archivedAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  process                Process?                @relation(fields: [processId], references: [id])
  facts                  CaseFact[]
  parties                CaseParty[]
  requests               CaseRequest[]
  risks                  CaseRisk[]
  drafts                 CaseDraft[]
  reviews                CaseReview[]
  timeline               CaseTimelineEvent[]
  comments               CaseComment[]
  annotations            CaseAnnotation[]
  approvals              DraftApproval[]
  alerts                 CaseAlert[]
  legalProcesses         LegalProcess[]
  documents              Document[]
  legalSources           CaseLegalSource[]
  officialCommunications OfficialCommunication[]
  officeMemories         OfficeMemory[]
  calendarEvents         CalendarEvent[]
  crmContacts            CrmContact[]

  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
  @@index([tribunalCode])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, deletedAt])
}

model OfficeMemory {
  id          String            @id @default(cuid())
  workspaceId String
  scope       OfficeMemoryScope
  caseId      String?
  ownerUserId String?
  title       String
  contentMd   String            @db.Text
  useAsModel  Boolean           @default(false)
  useAsStyle  Boolean           @default(false)
  optInSearch Boolean           @default(false) @map("optInRag")
  private     Boolean           @default(false)
  originType  String?
  originId    String?
  createdById String?
  updatedById String?
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  case      Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  ownerUser User?     @relation("OfficeMemoryOwnerUser", fields: [ownerUserId], references: [id])
  createdBy User?     @relation("OfficeMemoryCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("OfficeMemoryUpdatedBy", fields: [updatedById], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, scope])
  @@index([workspaceId, deletedAt])
  @@index([caseId])
  @@index([ownerUserId])
}

model CaseFact {
  id           String   @id @default(cuid())
  caseId       String
  /**
   * Ordem estável dentro do caso.
   */
  ordinal      Int
  text         String   @db.Text
  /**
   * Categoria heurística do fato (datado, conduta, dano, vínculo, etc).
   */
  category     String?
  /**
   * Datas detectadas no fato (ISO).
   */
  dates        String[] @default([])
  /**
   * Confidence 0..1 do parser.
   */
  confidence   Float    @default(0.6)
  /**
   * Metadata do item (origem/status/confidence override, vínculos de evidência, etc).
   * Usado para CRUD inline auditável sem inflar colunas.
   */
  metadataJson Json?
  createdAt    DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, ordinal])
  @@index([caseId])
}

model CaseParty {
  id           String        @id @default(cuid())
  caseId       String
  role         CasePartyRole
  kind         CasePartyKind @default(UNKNOWN)
  name         String
  /**
   * CPF/CNPJ quando detectado.
   */
  document     String?
  metadataJson Json?
  createdAt    DateTime      @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model CaseRequest {
  id            String          @id @default(cuid())
  caseId        String
  ordinal       Int
  kind          CaseRequestKind @default(MAIN)
  text          String          @db.Text
  /**
   * Norma de fundamentação (URN-LEX), opcional.
   */
  legalBasisUrn String?
  metadataJson  Json?
  createdAt     DateTime        @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, ordinal])
  @@index([caseId])
}

model CaseRisk {
  id               String           @id @default(cuid())
  caseId           String
  kind             CaseRiskKind
  severity         CaseRiskSeverity
  title            String
  detail           String           @db.Text
  /**
   * ChunkIds que motivaram o risco (referência rápida).
   */
  evidenceChunkIds String[]         @default([])
  /**
   * URNs envolvidas.
   */
  evidenceNormUrns String[]         @default([])
  /**
   * F4.5 — Metadata extra (ex.: documentId/documentName/evidence/suggestion
   * para riscos do tipo DOCUMENT_INCONSISTENCY). Mantém auditabilidade sem
   * inflar campos relacionais.
   */
  metadataJson     Json?
  resolvedAt       DateTime?
  resolvedById     String?
  createdAt        DateTime         @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, severity])
}

model CaseDraft {
  id                String          @id @default(cuid())
  caseId            String
  /**
   * Versão semântica auto-incremental por caso.
   */
  version           Int             @default(1)
  status            CaseDraftStatus @default(PENDING)
  /**
   * Conteúdo Markdown da minuta gerada.
   */
  content           String          @db.Text
  /**
   * ChunkIds usados como fundamentação ao gerar.
   */
  groundingChunkIds String[]        @default([])
  metadataJson      Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  case      Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approvals DraftApproval[]

  @@unique([caseId, version])
  @@index([caseId, version])
}

model CaseReview {
  id            String   @id @default(cuid())
  caseId        String
  /**
   * Score 0..1 — quanto a peça está pronta.
   */
  score         Float
  /**
   * Mensagem global ("Pronta para protocolo", "Pendências críticas").
   */
  verdict       String
  /**
   * Itens do checklist (JSON).
   */
  checklistJson Json
  /**
   * Risks Ids relacionados (snapshot).
   */
  riskIds       String[] @default([])
  createdAt     DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model CaseTimelineEvent {
  id                String           @id @default(cuid())
  caseId            String
  kind              CaseTimelineKind
  /**
   * Texto livre (ex.: "Draft v1 gerado a partir de 12 chunks").
   */
  message           String
  payloadJson       Json?
  /**
   * ChunkIds rastreados nesse evento (reasoning trace).
   */
  retrievalChunkIds String[]         @default([])
  /**
   * TraceID propagável p/ ObservabilityLog.
   */
  traceId           String?
  /**
   * UserId responsável.
   */
  userId            String?
  createdAt         DateTime         @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

/**
 * Fundamento jurídico pinado em um caso. O usuário busca em
 * `/pesquisa-juridica` (ou na aba Pesquisa do caso) e clica em "Usar no
 * caso" — gera um CaseLegalSource. Mais tarde, esses ids alimentam
 * `CaseDraft.groundingChunkIds[]`.
 * Não é cache de retrieval — é a curadoria do advogado sobre quais
 * fundamentos importam para esse caso.
 */
model CaseLegalSource {
  id         String   @id @default(cuid())
  caseId     String
  /**
   * Ponteiro lógico para `LegalChunk.id` (corpus oficial). Não criamos FK
   * dura porque o corpus é multi-tenant `_global_` e pode ser reindexado.
   */
  chunkId    String
  /**
   * Cópia denormalizada para evitar join no render (URN/articleRef).
   */
  normUrn    String?
  articleRef String?
  excerpt    String   @db.Text
  /**
   * Query original que originou o pin (para auditoria/UX).
   */
  query      String?
  pinnedById String?
  createdAt  DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, chunkId])
  @@index([caseId, createdAt])
  @@index([chunkId])
}

// ============================================================================
// COCKPIT OPERACIONAL — colaboração, alertas, integrações, notificações
// ============================================================================

enum CaseCommentVisibility {
  WORKSPACE
  PRIVATE
}

/**
 * Comentário interno entre advogados, vinculado a um caso e opcionalmente a uma minuta.
 */
model CaseComment {
  id          String                @id @default(cuid())
  caseId      String
  authorId    String
  draftId     String?
  body        String                @db.Text
  visibility  CaseCommentVisibility @default(WORKSPACE)
  refChunkIds String[]              @default([])
  resolved    Boolean               @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([authorId, createdAt])
  @@index([draftId])
}

enum CaseAnnotationKind {
  HIGHLIGHT
  WEAKNESS
  STRENGTH
  TODO
  CITATION
}

/**
 * Anotação visual no conteúdo de uma minuta (offset/length sobre Markdown).
 */
model CaseAnnotation {
  id          String             @id @default(cuid())
  caseId      String
  draftId     String?
  authorId    String
  kind        CaseAnnotationKind @default(HIGHLIGHT)
  startOffset Int
  endOffset   Int
  excerpt     String             @db.Text
  note        String?            @db.Text
  createdAt   DateTime           @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, draftId])
  @@index([authorId, createdAt])
}

enum DraftApprovalStatus {
  REQUESTED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

/**
 * Pedido + decisão de aprovação de minuta entre advogados.
 */
model DraftApproval {
  id          String              @id @default(cuid())
  caseId      String
  draftId     String
  requestedBy String
  reviewerId  String?
  status      DraftApprovalStatus @default(REQUESTED)
  rationale   String?             @db.Text
  decidedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  case  Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  draft CaseDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([caseId, status])
  @@index([draftId, status])
}

enum CaseAlertKind {
  JURISPRUDENCE_DRIFT
  THESIS_WEAKENED
  CONTEXTUAL_RISK
  RISING_RISK
  RELEVANT_MOVEMENT
  STRATEGIC_HISTORY
  NORM_REVOKED
  PRECEDENT_DIVERGENCE
  DEADLINE
}

enum CaseAlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseAlertStatus {
  OPEN
  ACKED
  DISMISSED
  RESOLVED
}

/**
 * Alerta operacional sobre um caso ou workspace (timeline viva).
 * Pode ser gerado por engine determinística (contradições, drift) ou por integração externa.
 */
model CaseAlert {
  id          String            @id @default(cuid())
  workspaceId String
  caseId      String?
  kind        CaseAlertKind
  severity    CaseAlertSeverity @default(INFO)
  status      CaseAlertStatus   @default(OPEN)
  title       String
  message     String            @db.Text
  reference   String?
  fingerprint String
  payloadJson Json?
  ackedAt     DateTime?
  ackedById   String?
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  case      Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, fingerprint])
  @@index([workspaceId, status, severity])
  @@index([caseId, status])
  @@index([workspaceId, kind, createdAt])
}

enum IntegrationProvider {
  PJE
  ESAJ
  PROJUDI
  EPROC
  DIARIO_OFICIAL
  EMAIL
  WHATSAPP
  CALENDAR
  WEBHOOK
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  PAUSED
}

/**
 * Configuração de integração externa por workspace.
 * Credenciais ficam em `secretRef` (chave de cofre / env), nunca em plaintext.
 */
model Integration {
  id           String              @id @default(cuid())
  workspaceId  String
  provider     IntegrationProvider
  label        String
  status       IntegrationStatus   @default(DISCONNECTED)
  configJson   Json?
  secretRef    String?
  lastSyncedAt DateTime?
  lastError    String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, label])
  @@index([workspaceId, provider, status])
}

enum NotificationKind {
  ALERT
  COMMENT
  APPROVAL
  INTEGRATION
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

/**
 * Notificação direcionada a um usuário (e/ou broadcast no workspace).
 */
model Notification {
  id          String             @id @default(cuid())
  workspaceId String
  userId      String?
  kind        NotificationKind
  status      NotificationStatus @default(UNREAD)
  title       String
  body        String             @db.Text
  href        String?
  refIds      String[]           @default([])
  payloadJson Json?
  readAt      DateTime?
  createdAt   DateTime           @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, status])
  @@index([workspaceId, kind, createdAt])
}

enum BetaLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISCARDED
}

// —— JustOS Pro CRM (multi-tenant por workspaceId) ——

enum CrmContactKind {
  CLIENT
  LEAD
  COUNTERPARTY
  WITNESS
  OTHER
}

enum CrmPipelineStage {
  NEW
  QUALIFIED
  ACTIVE
  WAITING_CLIENT
  PROPOSAL
  WON
  LOST
  ARCHIVED
}

enum CrmChannel {
  WHATSAPP
  EMAIL
  PHONE
  IN_PERSON
  SYSTEM
}

enum CrmMessageDirection {
  INBOUND
  OUTBOUND
}

enum CrmActivityType {
  NOTE
  CALL
  WHATSAPP_INBOUND
  WHATSAPP_OUTBOUND
  STAGE_CHANGE
  TASK
  FOLLOW_UP
  SYSTEM
}

model CrmContact {
  id             String           @id @default(cuid())
  workspaceId    String
  kind           CrmContactKind   @default(CLIENT)
  displayName    String
  phoneE164      String?
  email          String?
  documentId     String?
  pipelineStage  CrmPipelineStage @default(NEW)
  clientId       String?
  caseId         String?
  optOutWhatsapp   Boolean          @default(false)
  assignedToUserId String?
  metadataJson     Json?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client        Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case          Case?             @relation(fields: [caseId], references: [id], onDelete: SetNull)
  conversations CrmConversation[]
  activities    CrmActivity[]

  @@unique([workspaceId, phoneE164])
  @@index([workspaceId, pipelineStage])
  @@index([workspaceId, email])
  @@index([workspaceId, caseId])
  @@index([workspaceId, deletedAt])
}

model CrmConversation {
  id             String     @id @default(cuid())
  workspaceId    String
  contactId      String
  caseId         String?
  channel        CrmChannel @default(WHATSAPP)
  externalChatId String?
  lastMessageAt  DateTime?
  unreadCount        Int        @default(0)
  assignedToUserId   String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   CrmContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages  CrmMessage[]
  activities CrmActivity[]

  @@index([workspaceId, lastMessageAt])
  @@index([workspaceId, contactId])
  @@index([workspaceId, caseId])
}

model CrmMessage {
  id             String              @id @default(cuid())
  workspaceId    String
  conversationId String
  direction      CrmMessageDirection
  body           String              @db.Text
  sentAt         DateTime
  traceId        String?
  deliveryStatus String?
  metaJson       Json?
  createdAt      DateTime            @default(now())

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sentAt])
  @@index([conversationId, sentAt])
}

model CrmActivity {
  id               String          @id @default(cuid())
  workspaceId      String
  contactId        String
  caseId           String?
  conversationId   String?
  messageId        String?
  type             CrmActivityType
  title            String
  body             String?         @db.Text
  dueAt            DateTime?
  doneAt           DateTime?
  assignedToUserId String?
  metadataJson     Json?
  createdByUserId  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact      CrmContact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation CrmConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, contactId, createdAt])
  @@index([workspaceId, caseId, createdAt])
  @@index([workspaceId, type, dueAt])
  @@index([workspaceId, assignedToUserId, doneAt])
}

model JustosWhatsappSession {
  id           String    @id @default(cuid())
  workspaceId  String    @unique
  sessionKey   String
  openclawPort Int?
  status       String
  connectedAt  DateTime?
  phoneE164    String?
  lastHealthAt DateTime?
  metaJson     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([sessionKey])
  @@index([status])
}

/** Idempotência webhooks Asaas (e futuros providers). */
model JustosBillingEvent {
  id          String   @id @default(cuid())
  provider    String   @default("asaas")
  eventId     String
  eventType   String
  workspaceId String?
  rawHash     String
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@index([workspaceId, createdAt])
}

/**
 * Lead público da landing (beta / demonstração) — sem vínculo a workspace.
 */
model BetaLeadRequest {
  id             String         @id @default(cuid())
  name           String
  email          String
  company        String
  role           String?
  teamSize       String
  mainPain       String?        @db.Text
  intent         String         @default("beta")
  contactConsent Boolean
  source         String         @default("landing")
  status         BetaLeadStatus @default(NEW)
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  referrer       String?        @db.Text
  notes          String?        @db.Text
  contactedAt    DateTime?
  ipHash         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([email])
  @@index([createdAt])
  @@index([status])
}
