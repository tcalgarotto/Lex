# =====================================================================
# Lex — variáveis para PREVIEW (Vercel preview deployments).
#
# Use o mesmo Supabase Cloud e Inngest Cloud em modo "preview" (event key/app
# separados). Use namespace de Redis isolado ("lex:preview") para não cruzar
# rate-limits/cache com produção.
# =====================================================================

NODE_ENV=production
# [REQUIRED] Vercel preencherá automaticamente uma URL como https://<branch>-<hash>.vercel.app
# Para integração OAuth, adicione esta URL nas Redirect URLs do Supabase.
NEXT_PUBLIC_APP_URL=https://<branch>-<hash>.vercel.app
LOG_LEVEL=info
PRISMA_QUERY_LOGS=false

# Mesmo projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
STORAGE_BUCKET_DOCUMENTS=documents

# Redis (mesmo cluster, namespace separado)
REDIS_URL=
REDIS_REQUIRED=true
REDIS_NAMESPACE=lex:preview

# Qdrant (mesmo cluster, mesmas collections — preview lê dados reais somente leitura ideal)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_REQUIRED=true

# Inngest preview (app dedicado)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_APP_ID=lex-preview

DEEPSEEK_API_KEY=
DEEPINFRA_API_KEY=

ENABLE_CORPUS_SYNC=true
ENABLE_LEGAL_RETRIEVAL=true
ENABLE_CORPUS_GRAPH=true
ENABLE_INTEGRATIONS_MOCKS=true
ENABLE_E2E_TEST_HELPERS=true

# Legal providers — em preview deixe LexML/STF/STJ em fixture para evitar
# bater nas APIs públicas a cada deploy.
LEXML_PROVIDER_MODE=fixture
STF_PROVIDER_MODE=fixture
STJ_PROVIDER_MODE=fixture
DATAJUD_PROVIDER_MODE=disabled
ENABLE_LEXML_PROVIDER=true
ENABLE_STF_PROVIDER=true
ENABLE_STJ_PROVIDER=true
ENABLE_DATAJUD=false
