# =====================================================================
# Lex — exemplo de variáveis (DESENVOLVIMENTO LOCAL).
#   cp .env.example .env
# Para produção, use `.env.production.example` como referência.
# Nunca commit .env real (já está no .gitignore).
# =====================================================================

# ---------- A) App ----------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Dev na LAN (celular na mesma Wi‑Fi): IP do host sem porta — ver docs/DEV_LAN_ACCESS.md
# ALLOWED_DEV_ORIGINS=192.168.0.27
LOG_LEVEL=warn
PRISMA_QUERY_LOGS=false

# ---------- B) Supabase (Auth + Storage + Postgres) ----------
# Project Settings → API → Project URL / anon key / service_role key
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (Supabase pooler):
#   DATABASE_URL = pooler em modo TRANSACTION (PgBouncer, porta 6543)
#   DIRECT_URL   = pooler em modo SESSION (porta 5432) — apenas para migrations
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Prisma shadow database (dev): necessário para `prisma migrate dev` sem drift.
# Recomendação: usar o MESMO banco, mas com schema separado (ex.: `shadow_prisma`).
# 1) Crie o schema (uma vez) no Postgres:
#    CREATE SCHEMA IF NOT EXISTS shadow_prisma;
# 2) Aponte a URL abaixo para esse schema.
#
# Exemplo (Supabase): copie o DIRECT_URL e adicione `?schema=shadow_prisma`
SHADOW_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?schema=shadow_prisma

STORAGE_BUCKET_DOCUMENTS=documents

# Red team FASE 3.2 — Storage policy remoto (STAGING apenas; nunca produção)
# Red-team Storage remoto (staging — nunca produção com dados reais)
# RED_TEAM_CONFIRM_STAGING=1
# E-mails padrão do código (fixture-ids.ts); override opcional:
# SUPABASE_TEST_USER_A_EMAIL=redteam-common-a@fixture.lex.invalid
# SUPABASE_TEST_USER_B_EMAIL=redteam-common-b@fixture.lex.invalid
# Alternativa documentada: redteam-a@lex.test / redteam-b@lex.test (criar no Supabase Auth + sync)
# SUPABASE_TEST_USER_A_PASSWORD=   # só no .env local — nunca commitar
# SUPABASE_TEST_USER_B_PASSWORD=
# Verificação SQL (read-only): npm run security:storage:hardening-check
# Depois: npm run security:red-team:staging-check && RED_TEAM_CONFIRM_STAGING=1 npm run security:red-team:test
# Quota padrão da nuvem de documentos por workspace (bytes). 2147483648 = 2 GiB.
DEFAULT_WORKSPACE_STORAGE_QUOTA_BYTES=2147483648
# Tamanho máximo por ficheiro no plano padrão (bytes). 104857600 = 100 MiB.
DEFAULT_MAX_UPLOAD_FILE_SIZE_BYTES=104857600

# ---------- C) Redis ----------
# Em DEV é OPCIONAL: se não definir, rate-limit/cache caem para fail-open
# silencioso (sem spam de ECONNREFUSED). Para usar Redis local:
#   docker compose up -d redis
# ou Upstash REST/TCP em dev (recomendado para evitar Docker local).
REDIS_URL=
REDIS_REQUIRED=false
REDIS_NAMESPACE=lex:dev
# Rate limit: em produção use REDIS_REQUIRED=true + RATE_LIMIT_FAIL_CLOSED=true (ver .env.production.example).
# Somente desenvolvimento local — nunca em produção:
RATE_LIMIT_FAIL_CLOSED=false
RATE_LIMIT_FAIL_OPEN_DEV=1

# ---------- D) Qdrant (vetorial) ----------
# Em DEV pode usar docker compose (http://localhost:6333) ou Qdrant Cloud.
QDRANT_URL=https://<your-cluster>.qdrant.io
QDRANT_API_KEY=
# Collections — defaults seguros já configurados em src/lib/corpus/qdrant-collections.ts
QDRANT_COLLECTION=lex_main
QDRANT_COLLECTION_CORPUS_NORMS=lex_corpus_norms
QDRANT_COLLECTION_CORPUS_JURISPRUDENCE=lex_corpus_jurisprudence
# Em prod = true (default). Em dev pode = false.
QDRANT_REQUIRED=false

# ---------- E) Inngest (jobs) ----------
# Em dev: `npx inngest-cli@latest dev` cria um worker local que descobre /api/inngest.
# Em prod: usar Inngest Cloud (event key + signing key abaixo).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_APP_ID=lex-dev

# ---------- E.1) JustOS → n8n (automação local) ----------
# Mesmo secret que LEX_N8N_WEBHOOK_SECRET no container n8n (sold-credentials.env).
LEX_N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/justos-case-secretary
LEX_N8N_WEBHOOK_SECRET=
# Bearer para n8n chamar POST/GET /api/cases/[id]/* (draft, brain, review, case-brain).
LEX_N8N_SERVICE_TOKEN=
# Opcional: userId usado nas ações disparadas pelo n8n (default: createdById do caso).
LEX_N8N_ACTOR_USER_ID=
# Emite eventos mesmo sem onboardingJson.justos.enabled (só dev).
JUSTOS_DEV_EMIT=false

# ---------- E.2) JustOS Pro — Asaas Sandbox (pagamentos) ----------
# Docs: https://docs.asaas.com/reference/comece-por-aqui
# Sandbox: https://api-sandbox.asaas.com — use chave de API de testes (produção retorna 401 na doc).
ASAAS_API_KEY=aact_hmlg_000MzkwODA2MWY2OGM3MWRlMDU2NWM3MzJlNzZmNGZhZGY6OjdlY2Q4Zjc5LThmOTctNDlmZC1iYjNiLTI2Y2RjNjdmMmFlOTo6JGFhY2hfZTZkYTQ0ZjUtNjNjMi00MDFhLWFkMTQtMzQ3NzMyN2ZiYzI1
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com
# Token do painel Asaas → Webhooks → validado no header `asaas-access-token`
ASAAS_WEBHOOK_TOKEN=whsec_5hWokdNZaEbMXGPHyCguEhA-yn0CZdczwyiGgEaLdd4
# `immediate` = ativa Pro sem cobrança (dev). Omita ou deixe vazio para fluxo real.
ASAAS_BILLING_MODE=
# CPF válido só no Sandbox (cliente de teste)
ASAAS_SANDBOX_DEFAULT_CPF=24971563792
# PIX | CREDIT_CARD (boleto não suportado). Sandbox cartão: 4444 4444 4444 4444
ASAAS_BILLING_TYPE=CREDIT_CARD
# Bypass entitlement quando status inactive (só dev)
JUSTOS_PRO_DEV_BYPASS=false

# JustOS Command sidecar (:3301) — WhatsApp multi-tenant
JUSTOS_COMMAND_URL=http://127.0.0.1:3301
JUSTOS_COMMAND_SECRET=
JUSTOS_API_BASE_URL=http://127.0.0.1:3000
JUSTOS_USE_LEGACY_BRIDGE=false
JUSTOS_CRM_ENABLE_WA_SEND=false
# dev-single = bridge SOLD :3310 (1 WhatsApp global)
# process-per-workspace = 1 OpenClaw + porta por escritório (teste multi-tenant)
JUSTOS_OPENCLAW_MODE=process-per-workspace
JUSTOS_OPENCLAW_PORT_BASE=34000
OPENCLAW_ENTRY=/home/thales/OpenClaw/index.js
# Dev: aceitar webhook Asaas sem token (nunca em produção)
# ASAAS_WEBHOOK_ALLOW_UNAUTH_DEV=true

# Preços Pro (BRL) — usados na assinatura Asaas
JUSTOS_PRO_PRICE_MONTHLY_BRL=129.9
JUSTOS_PRO_PRICE_YEARLY_BRL=1099

# ---------- F) IA (chat + embeddings + reranker) ----------
AI_CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Embeddings BGE-M3 + reranker BGE-v2-m3 via DeepInfra
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# ---------- G) Auth/OAuth (Supabase) ----------
# Configurados na console Supabase (Auth → URL Configuration / Providers).
# Variáveis aqui são apenas para documentação local — Supabase guarda os segredos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- H) Email ----------
# Em dev: deixe vazio — `emailAdapter` opera em dry-run.
RESEND_API_KEY=
EMAIL_FROM="Lex <no-reply@lex.local>"
# Notificação interna de novo lead na landing (opcional em dev)
BETA_LEAD_NOTIFY_TO=comercial@seu-dominio.com
BETA_LEAD_NOTIFY_FROM=
# Allowlist opcional para painel de leads (além de OWNER do workspace)
LEX_BETA_LEADS_ADMIN_EMAILS=
LEX_BETA_LEADS_NOTIFY_TO=
# Salt opcional para hash de IP em leads (default: AUTH_SECRET)
BETA_LEAD_IP_SALT=

# ---------- I) Observabilidade ----------
# Sentry (org lotys / project lex) — https://sentry.io/settings/lotys/projects/lex/keys/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# CI/Vercel: upload de source maps (nunca commitar)
SENTRY_AUTH_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- J) Provedores jurídicos externos (corpus indexado) ----------
# Modos suportados: live | fixture | disabled
# Ver docs/LEGAL_PROVIDERS.md para o que cada provider cobre.

# LexML — vade mecum federal, sem chave (SRU/XML público)
LEXML_BASE_URL=https://www.lexml.gov.br/busca/SRU
LEXML_PROVIDER_MODE=fixture
LEXML_DEFAULT_PAGE_SIZE=50
LEXML_MAX_PAGES_PER_SYNC=20
LEXML_RATE_LIMIT_PER_MINUTE=20

# STF — súmulas + súmulas vinculantes, sem chave (HTML público)
STF_BASE_URL=https://portal.stf.jus.br
STF_PROVIDER_MODE=fixture
STF_RATE_LIMIT_PER_MINUTE=10

# STJ — súmulas + jurisprudência via SCON, sem chave (HTML público)
STJ_BASE_URL=https://processo.stj.jus.br
STJ_PROVIDER_MODE=fixture
STJ_RATE_LIMIT_PER_MINUTE=10

# DataJud — movimentações processuais (CNJ), exige DATAJUD_API_KEY
# Onde pegar: https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_API_KEY=
DATAJUD_DEFAULT_ALIAS=api_publica_tjrs
DATAJUD_MODE=disabled
DATAJUD_PROVIDER_MODE=off
DATAJUD_DEFAULT_PAGE_SIZE=100
DATAJUD_MAX_PAGES_PER_SYNC=10
DATAJUD_RATE_LIMIT_PER_MINUTE=30
DATAJUD_SYNC_DAILY_ENABLED=false
DATAJUD_SYNC_DAILY_HOUR=6

# Câmara dos Deputados — dados abertos REST/JSON, sem chave
CAMARA_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
CAMARA_PROVIDER_MODE=fixture
CAMARA_RATE_LIMIT_PER_MINUTE=30

# Senado Federal — dados abertos REST/JSON, sem chave
SENADO_BASE_URL=https://legis.senado.leg.br/dadosabertos
SENADO_PROVIDER_MODE=fixture
SENADO_RATE_LIMIT_PER_MINUTE=30

# ---------- K) Feature flags ----------
ENABLE_CORPUS_SYNC=true
# Quando false, desliga pesquisa jurídica assistida (DeepSeek) e curto-circuito do retrieval jurídico.
ENABLE_LEGAL_RETRIEVAL=true
ENABLE_CORPUS_GRAPH=true
ENABLE_COCKPIT=true
ENABLE_STRATEGY=true
ENABLE_LAWYER_BRAIN=true
ENABLE_INTEGRATIONS_MOCKS=true
ENABLE_E2E_TEST_HELPERS=false

# Toggles de provedores (true|false)
# Em dev mantenha-os habilitados — `*_PROVIDER_MODE=fixture` evita rede.
ENABLE_LEXML_PROVIDER=true
ENABLE_STF_PROVIDER=true
ENABLE_STJ_PROVIDER=true
ENABLE_DATAJUD=true
ENABLE_CAMARA_PROVIDER=true
ENABLE_SENADO_PROVIDER=true

# ---------- OCR (opcional) ----------
OCR_PROVIDER=tesseract
MISTRAL_API_KEY=

# ---------- Biblioteca global (opcional) ----------
# Workspace do catálogo Lex partilhado por toda a plataforma (slug fixo `lex-platform-catalog`).
# Criar: npx tsx --env-file=.env scripts/ensure-platform-library-workspace.ts
# LEX_PLATFORM_LIBRARY_WORKSPACE_ID=

# ---------- Seed (dev) ----------
SEED_USER_EMAIL=dev@lex.local
SEED_USER_ID=

# DeepSeek Legal Research Mode (P0 — modo temporário; ver docs/decisions/ADR_DEEPSEEK_LEGAL_RESEARCH_MODE.md)
LEGAL_RESEARCH_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_LEGAL_RESEARCH_ENABLED=true
DEEPSEEK_LEGAL_RESEARCH_TIMEOUT_MS=15000
RAG_LEGAL_RESEARCH_ENABLED=false
LEGAL_RESEARCH_REQUIRE_HUMAN_REVIEW=true
LEGAL_RESEARCH_CACHE_TTL_MS=600000
LEGAL_RESEARCH_RATE_LIMIT_PER_MIN=30
