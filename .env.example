# =====================================================================
# Lex — exemplo de variáveis (DESENVOLVIMENTO LOCAL).
#   cp .env.example .env
# Para produção, use `.env.production.example` como referência.
# Nunca commit .env real (já está no .gitignore).
# =====================================================================

# ---------- A) App ----------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=warn
PRISMA_QUERY_LOGS=false

# ---------- B) Supabase (Auth + Storage + Postgres) ----------
# Project Settings → API → Project URL / anon key / service_role key
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (Supabase pooler):
#   DATABASE_URL = pooler em modo TRANSACTION (PgBouncer, porta 6543)
#   DIRECT_URL   = pooler em modo SESSION (porta 5432) — apenas para migrations
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Prisma shadow database (dev): necessário para `prisma migrate dev` sem drift.
# Recomendação: usar o MESMO banco, mas com schema separado (ex.: `shadow_prisma`).
# 1) Crie o schema (uma vez) no Postgres:
#    CREATE SCHEMA IF NOT EXISTS shadow_prisma;
# 2) Aponte a URL abaixo para esse schema.
#
# Exemplo (Supabase): copie o DIRECT_URL e adicione `?schema=shadow_prisma`
SHADOW_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?schema=shadow_prisma

STORAGE_BUCKET_DOCUMENTS=documents

# ---------- C) Redis ----------
# Em DEV é OPCIONAL: se não definir, rate-limit/cache caem para fail-open
# silencioso (sem spam de ECONNREFUSED). Para usar Redis local:
#   docker compose up -d redis
# ou Upstash REST/TCP em dev (recomendado para evitar Docker local).
REDIS_URL=
REDIS_REQUIRED=false
REDIS_NAMESPACE=lex:dev

# ---------- D) Qdrant (vetorial) ----------
# Em DEV pode usar docker compose (http://localhost:6333) ou Qdrant Cloud.
QDRANT_URL=https://<your-cluster>.qdrant.io
QDRANT_API_KEY=
# Collections — defaults seguros já configurados em src/lib/corpus/qdrant-collections.ts
QDRANT_COLLECTION=lex_main
QDRANT_COLLECTION_CORPUS_NORMS=lex_corpus_norms
QDRANT_COLLECTION_CORPUS_JURISPRUDENCE=lex_corpus_jurisprudence
# Em prod = true (default). Em dev pode = false.
QDRANT_REQUIRED=false

# ---------- E) Inngest (jobs) ----------
# Em dev: `npx inngest-cli@latest dev` cria um worker local que descobre /api/inngest.
# Em prod: usar Inngest Cloud (event key + signing key abaixo).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_APP_ID=lex-dev

# ---------- F) IA (chat + embeddings + reranker) ----------
AI_CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Embeddings BGE-M3 + reranker BGE-v2-m3 via DeepInfra
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# ---------- G) Auth/OAuth (Supabase) ----------
# Configurados na console Supabase (Auth → URL Configuration / Providers).
# Variáveis aqui são apenas para documentação local — Supabase guarda os segredos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- H) Email ----------
# Em dev: deixe vazio — `emailAdapter` opera em dry-run.
RESEND_API_KEY=
EMAIL_FROM="Lex <no-reply@lex.local>"

# ---------- I) Observabilidade ----------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- J) Provedores jurídicos externos (corpus RAG) ----------
# Modos suportados: live | fixture | disabled
# Ver docs/LEGAL_PROVIDERS.md para o que cada provider cobre.

# LexML — vade mecum federal, sem chave (SRU/XML público)
LEXML_BASE_URL=https://www.lexml.gov.br/busca/SRU
LEXML_PROVIDER_MODE=fixture
LEXML_DEFAULT_PAGE_SIZE=50
LEXML_MAX_PAGES_PER_SYNC=20
LEXML_RATE_LIMIT_PER_MINUTE=20

# STF — súmulas + súmulas vinculantes, sem chave (HTML público)
STF_BASE_URL=https://portal.stf.jus.br
STF_PROVIDER_MODE=fixture
STF_RATE_LIMIT_PER_MINUTE=10

# STJ — súmulas + jurisprudência via SCON, sem chave (HTML público)
STJ_BASE_URL=https://scon.stj.jus.br
STJ_PROVIDER_MODE=fixture
STJ_RATE_LIMIT_PER_MINUTE=10

# DataJud — movimentações processuais (CNJ), exige DATAJUD_API_KEY
# Onde pegar: https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_API_KEY=
DATAJUD_ALIAS=api_publica_tjsp
DATAJUD_PROVIDER_MODE=disabled
DATAJUD_DEFAULT_PAGE_SIZE=100
DATAJUD_MAX_PAGES_PER_SYNC=10
DATAJUD_RATE_LIMIT_PER_MINUTE=30

# Câmara dos Deputados — dados abertos REST/JSON, sem chave
CAMARA_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
CAMARA_PROVIDER_MODE=fixture
CAMARA_RATE_LIMIT_PER_MINUTE=30

# Senado Federal — dados abertos REST/JSON, sem chave
SENADO_BASE_URL=https://legis.senado.leg.br/dadosabertos
SENADO_PROVIDER_MODE=fixture
SENADO_RATE_LIMIT_PER_MINUTE=30

# ---------- K) Feature flags ----------
ENABLE_CORPUS_SYNC=true
ENABLE_LEGAL_RETRIEVAL=true
ENABLE_CORPUS_GRAPH=true
ENABLE_COCKPIT=true
ENABLE_STRATEGY=true
ENABLE_LAWYER_BRAIN=true
ENABLE_INTEGRATIONS_MOCKS=true
ENABLE_E2E_TEST_HELPERS=false

# Toggles de provedores (true|false)
# Em dev mantenha-os habilitados — `*_PROVIDER_MODE=fixture` evita rede.
ENABLE_LEXML_PROVIDER=true
ENABLE_STF_PROVIDER=true
ENABLE_STJ_PROVIDER=true
ENABLE_DATAJUD=true
ENABLE_CAMARA_PROVIDER=true
ENABLE_SENADO_PROVIDER=true

# ---------- OCR (opcional) ----------
OCR_PROVIDER=tesseract
MISTRAL_API_KEY=

# ---------- Seed (dev) ----------
SEED_USER_EMAIL=dev@lex.local
SEED_USER_ID=
